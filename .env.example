# Copy to .env for local development and fill in real values.
# On Vercel, set these in Project Settings -> Environment Variables.
# Never commit the real .env file.

# --- Client-side (bundled into the browser build by Vite) ---
# Safe to expose publicly; must be the publishable/anon key, never a secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server-side (SSR + server functions; not exposed to the browser) ---
# Same values as above, unprefixed. Both sets are required.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-ref

# --- Secret (server only) ---
# Bypasses row-level security. Required by the view counter
# (bumpPortfolioView in src/lib/views.functions.ts).
# Set only in the Vercel dashboard. Never commit or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
